# MongoDB Atlas connection string
DATABASE_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gym-app?retryWrites=true&w=majority

# Generate a long random value for Payload auth/session signing
PAYLOAD_SECRET=replace-with-at-least-32-random-characters

# Your deployed Vercel URL, for example:
# NEXT_PUBLIC_SERVER_URL=https://gym-app-example.vercel.app
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional but recommended on Vercel for persistent Payload Media uploads.
# Vercel adds this automatically after you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=
